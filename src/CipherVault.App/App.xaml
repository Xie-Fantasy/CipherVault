<Application x:Class="CipherVault.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CipherVault.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Light theme colors (default; ThemeManager swaps to DarkColors.xaml at runtime if needed) -->
                <ResourceDictionary Source="pack://application:,,,/CipherVault.UI;component/Themes/Colors.xaml" />
                <!-- Typography: font families and sizes -->
                <ResourceDictionary Source="pack://application:,,,/CipherVault.UI;component/Themes/Typography.xaml" />
                <!-- Global control styles -->
                <ResourceDictionary Source="pack://application:,,,/CipherVault.UI;component/Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
