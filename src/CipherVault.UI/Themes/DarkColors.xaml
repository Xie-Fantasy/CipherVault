<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Background -->
    <Color x:Key="ColorBackground">#1C1C1E</Color>
    <Color x:Key="ColorSurface">#2C2C2E</Color>
    <Color x:Key="ColorSurfaceHover">#3A3A3C</Color>
    <Color x:Key="ColorSurfaceActive">#48484A</Color>
    <Color x:Key="ColorBorder">#38383A</Color>
    <Color x:Key="ColorBorderFocus">#0A84FF</Color>

    <!-- Text -->
    <Color x:Key="ColorTextPrimary">#F5F5F7</Color>
    <Color x:Key="ColorTextSecondary">#98989D</Color>
    <Color x:Key="ColorTextTertiary">#636366</Color>
    <Color x:Key="ColorTextInverse">#FFFFFF</Color>

    <!-- Primary -->
    <Color x:Key="ColorPrimary">#0A84FF</Color>
    <Color x:Key="ColorPrimaryHover">#409CFF</Color>
    <Color x:Key="ColorPrimaryPress">#0070E0</Color>
    <Color x:Key="ColorPrimarySubtle">#200A84FF</Color>

    <!-- Semantic -->
    <Color x:Key="ColorSuccess">#30D158</Color>
    <Color x:Key="ColorWarning">#FF9F0A</Color>
    <Color x:Key="ColorDanger">#FF453A</Color>
    <Color x:Key="ColorDangerSubtle">#20FF453A</Color>
    <Color x:Key="ColorFavorite">#FF9F0A</Color>

    <!-- SolidColorBrush versions for direct use -->
    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceHover" Color="{StaticResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="BrushSurfaceActive" Color="{StaticResource ColorSurfaceActive}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderFocus" Color="{StaticResource ColorBorderFocus}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextTertiary" Color="{StaticResource ColorTextTertiary}" />
    <SolidColorBrush x:Key="BrushTextInverse" Color="{StaticResource ColorTextInverse}" />
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushPrimaryHover" Color="{StaticResource ColorPrimaryHover}" />
    <SolidColorBrush x:Key="BrushPrimaryPress" Color="{StaticResource ColorPrimaryPress}" />
    <SolidColorBrush x:Key="BrushPrimarySubtle" Color="{StaticResource ColorPrimarySubtle}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushDangerSubtle" Color="{StaticResource ColorDangerSubtle}" />
    <SolidColorBrush x:Key="BrushFavorite" Color="{StaticResource ColorFavorite}" />
</ResourceDictionary>
