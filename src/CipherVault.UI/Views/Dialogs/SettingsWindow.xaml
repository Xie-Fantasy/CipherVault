<Window x:Class="CipherVault.UI.Views.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CipherVault.UI.ViewModels"
        xmlns:conv="clr-namespace:CipherVault.UI.Converters"
        xmlns:loc="clr-namespace:CipherVault.UI.Localization"
        xmlns:h="clr-namespace:CipherVault.UI.Helper"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="设置"
        Width="900" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushBackground}"
        WindowStyle="None"
        AllowsTransparency="True"
        Closing="SettingsWindow_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="12"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:LocalizedFormatConverter x:Key="LocalizedFormat" />
        <!-- Tab RadioButton Style -->
        <Style x:Key="TabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushPrimarySubtle}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Setting Row Style -->
        <Style x:Key="SettingRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="0,15" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="AppearanceCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="AppearanceChoiceRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceSurface"
                                Background="{DynamicResource BrushBackground}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceSurface"
                                        Property="Background"
                                        Value="{DynamicResource BrushSurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceSurface"
                                        Property="Background"
                                        Value="{DynamicResource BrushPrimarySubtle}" />
                                <Setter TargetName="ChoiceSurface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource BrushPrimary}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource BrushPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A compact, rounded scrollbar for the settings surface. -->
        <Style x:Key="SettingsScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbSurface"
                                Background="{DynamicResource BrushTextTertiary}"
                                CornerRadius="3"
                                Opacity="0.42" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource BrushPrimary}" />
                                <Setter TargetName="ThumbSurface" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="{TemplateBinding Width}" Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SettingsScrollThumbStyle}"
                                           HorizontalAlignment="Center" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <conv:ThemeModeToBoolConverter x:Key="ThemeModeConverter" />
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{DynamicResource BrushBackground}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.15" />
        </Border.Effect>

        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top" Margin="32,24,32,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SettingsTitleText"
                               Grid.Column="0"
                               Text="设置"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Style="{StaticResource IconButton}"
                            Click="CloseButton_Click"
                            FocusVisualStyle="{x:Null}"
                            ToolTip="关闭">
                        <h:AppIcon Icon="{x:Static h:Icon.X}" Size="14" />
                    </Button>
                </Grid>
            </Border>

            <!-- Bottom bar -->
            <Border DockPanel.Dock="Bottom"
                    Margin="32,0,32,24"
                    Padding="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusMessage}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Column="1"
                            Style="{StaticResource GhostButton}"
                            Content="重置默认"
                            Command="{Binding ResetToDefaultsCommand}"
                            Width="164"
                            Margin="0,0,8,0" />

                    <Button Grid.Column="2"
                            Style="{StaticResource GhostButton}"
                            Content="取消"
                            Click="CancelButton_Click"
                            Width="92"
                            Margin="0,0,8,0" />

                    <Button Grid.Column="3"
                            Style="{StaticResource FlatButton}"
                            Content="保存"
                            Click="SaveButton_Click"
                            Width="100" />
                </Grid>
            </Border>

            <!-- Main content: sidebar + settings area -->
            <Grid Margin="32,24,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left sidebar: category navigation -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8"
                        Height="420"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <RadioButton x:Name="SecurityTab"
                                     GroupName="SettingsTabs"
                                     IsChecked="True"
                                     Tag="Security"
                                     Style="{StaticResource TabRadioButtonStyle}"
                                     Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <h:AppIcon Icon="{x:Static h:Icon.Unlock}" Size="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="安全" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="AppearanceTab"
                                     GroupName="SettingsTabs"
                                     Tag="Appearance"
                                     Style="{StaticResource TabRadioButtonStyle}"
                                     Checked="Tab_Checked"
                                     Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <h:AppIcon Icon="{x:Static h:Icon.Info}" Size="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="外观" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="BackupTab"
                                     GroupName="SettingsTabs"
                                     Tag="Backup"
                                     Style="{StaticResource TabRadioButtonStyle}"
                                     Checked="Tab_Checked"
                                     Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <h:AppIcon Icon="{x:Static h:Icon.User}" Size="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="备份" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="HotkeyTab"
                                     GroupName="SettingsTabs"
                                     Tag="Hotkey"
                                     Style="{StaticResource TabRadioButtonStyle}"
                                     Checked="Tab_Checked"
                                     Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <h:AppIcon Icon="{x:Static h:Icon.Keyboard}" Size="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="快捷键" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TrayTab"
                                     GroupName="SettingsTabs"
                                     Tag="Tray"
                                     Style="{StaticResource TabRadioButtonStyle}"
                                     Checked="Tab_Checked"
                                     Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <h:AppIcon Icon="{x:Static h:Icon.HardDrive}" Size="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="系统托盘" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Right content area -->
                <ScrollViewer Grid.Column="1"
                              Margin="24,0,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar"
                               BasedOn="{StaticResource SettingsScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <Grid Margin="0,0,12,0">
                        <!-- Security settings -->
                        <StackPanel x:Name="SecurityPanel" Visibility="Visible">
                            <TextBlock Text="安全设置"
                                       FontSize="{DynamicResource FontSizeSubtitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       Margin="0,0,0,16" />

                            <!-- Idle timeout -->
                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <TextBlock Text="空闲超时锁定"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="无操作后自动锁定保险库"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Slider Width="120"
                                                Minimum="1" Maximum="60"
                                                Value="{Binding IdleTimeoutMinutes}"
                                                VerticalAlignment="Center" />
                                        <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Width="88"
                                                   TextAlignment="Right"
                                                   Margin="8,0,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource LocalizedFormat}"
                                                              ConverterParameter="{}{0} 分钟">
                                                    <Binding Path="IdleTimeoutMinutes" />
                                                    <Binding Source="{x:Static loc:LocalizationManager.Instance}"
                                                             Path="LanguageVersion" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Lock on system lock -->
                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <TextBlock Text="系统锁屏时锁定"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="Windows 锁屏 (Win+L) 时自动锁定"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource FlatToggleButton}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding LockOnSystemLock}" />
                                </Grid>
                            </Border>

                            <!-- Lock on window blur -->
                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <TextBlock Text="窗口失焦时锁定"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="切换到其他应用时自动锁定"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource FlatToggleButton}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding LockOnWindowBlur}" />
                                </Grid>
                            </Border>

                            <!-- Lock on minimize -->
                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <TextBlock Text="最小化时锁定"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="最小化窗口时自动锁定"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource FlatToggleButton}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding LockOnMinimize}" />
                                </Grid>
                            </Border>

                            <!-- Clipboard clear seconds -->
                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <TextBlock Text="剪贴板自动清除"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="复制敏感内容后自动覆盖剪贴板"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Slider Width="120" Minimum="5" Maximum="60"
                                                Value="{Binding ClipboardClearSeconds}"
                                                VerticalAlignment="Center" />
                                        <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   VerticalAlignment="Center" Width="88"
                                                   TextAlignment="Right" Margin="8,0,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource LocalizedFormat}"
                                                              ConverterParameter="{}{0} 秒">
                                                    <Binding Path="ClipboardClearSeconds" />
                                                    <Binding Source="{x:Static loc:LocalizationManager.Instance}"
                                                             Path="LanguageVersion" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="截屏防护（默认关闭）"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="开启后，截图、录屏及部分远程协助工具将无法捕获应用窗口"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource FlatToggleButton}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding AntiCaptureEnabled}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="Windows Hello 快速解锁"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="{Binding WindowsHelloStatus}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource FlatToggleButton}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding WindowsHelloEnabled}"
                                                  IsEnabled="{Binding WindowsHelloAvailable}"
                                                  ToolTip="使用 Windows PIN、面容或指纹解锁" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Appearance settings -->
                        <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                            <TextBlock Text="外观设置"
                                       FontSize="{DynamicResource FontSizeSubtitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       Margin="0,0,0,16" />

                            <Border Style="{StaticResource AppearanceCardStyle}">
                                <StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="主题模式"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="切换后立即预览，保存后下次启动继续使用"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0"
                                                     Style="{StaticResource AppearanceChoiceRadioStyle}"
                                                     Content="浅色模式"
                                                     GroupName="ThemeMode"
                                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource ThemeModeConverter}, ConverterParameter=Light}"
                                                     Margin="0,0,6,0" />
                                        <RadioButton Grid.Column="1"
                                                     Style="{StaticResource AppearanceChoiceRadioStyle}"
                                                     Content="黑夜模式"
                                                     GroupName="ThemeMode"
                                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource ThemeModeConverter}, ConverterParameter=Dark}"
                                                     Margin="3,0" />
                                        <RadioButton Grid.Column="2"
                                                     Style="{StaticResource AppearanceChoiceRadioStyle}"
                                                     Content="跟随系统"
                                                     GroupName="ThemeMode"
                                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource ThemeModeConverter}, ConverterParameter=System}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource AppearanceCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="界面语言"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="切换后立即应用到所有窗口"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              Height="36"
                                              VerticalAlignment="Center"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding SelectedLanguage}">
                                        <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                                        <ComboBoxItem Content="English" Tag="en-US" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource AppearanceCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="界面字号"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="调整列表和详情文字大小"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              Height="36"
                                              VerticalAlignment="Center"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding FontSize}">
                                        <ComboBoxItem Content="小" Tag="small" />
                                        <ComboBoxItem Content="中" Tag="medium" />
                                        <ComboBoxItem Content="大" Tag="large" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Backup settings -->
                        <StackPanel x:Name="BackupPanel" Visibility="Collapsed">
                            <TextBlock Text="备份设置"
                                       FontSize="{DynamicResource FontSizeSubtitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       Margin="0,0,0,16" />

                            <!-- Auto backup -->
                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="自动备份"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="每次修改后自动创建备份"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource FlatToggleButton}"
                                                  IsChecked="{Binding AutoBackup}" />
                                </Grid>
                            </Border>

                            <!-- Backup directory -->
                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="备份目录"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBox Style="{StaticResource FlatTextBox}"
                                                 Text="{Binding BackupDirectory}"
                                                 IsReadOnly="True"
                                                 Margin="0,6,0,0"
                                                 Height="32" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource GhostButton}"
                                            Content="浏览..."
                                            Command="{Binding BrowseBackupDirectoryCommand}"
                                            Margin="8,18,0,0"
                                            Width="80" />
                                </Grid>
                            </Border>

                            <!-- Max backups -->
                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="最大备份数量"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="超过此数量时自动删除旧备份"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource FlatTextBox}"
                                             Text="{Binding MaxBackups, UpdateSourceTrigger=PropertyChanged}"
                                             Width="80"
                                             Height="32"
                                             HorizontalContentAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Hotkey settings -->
                        <StackPanel x:Name="HotkeyPanel" Visibility="Collapsed">
                            <TextBlock Text="快捷键设置"
                                       FontSize="{DynamicResource FontSizeSubtitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       Margin="0,0,0,16" />

                            <!-- Global search hotkey -->
                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="全局搜索"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="从任何应用快速搜索密码"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource FlatTextBox}"
                                             Text="{Binding GlobalSearchHotkey, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="False"
                                             Width="140"
                                             Height="32"
                                             ToolTip="例如 Ctrl+Shift+P"
                                             HorizontalContentAlignment="Center" />
                                </Grid>
                            </Border>

                        </StackPanel>

                        <!-- Tray settings -->
                        <StackPanel x:Name="TrayPanel" Visibility="Collapsed">
                            <TextBlock Text="系统托盘设置"
                                       FontSize="{DynamicResource FontSizeSubtitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       Margin="0,0,0,16" />

                            <!-- Close-button behavior -->
                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="点击关闭按钮时"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="可每次询问、隐藏到托盘或直接退出"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              Height="38"
                                              VerticalAlignment="Center"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding CloseBehavior}">
                                        <ComboBoxItem Content="每次询问" Tag="ask" />
                                        <ComboBoxItem Content="最小化到系统托盘" Tag="tray" />
                                        <ComboBoxItem Content="直接退出程序" Tag="exit" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Start with Windows -->
                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="开机自启动"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="Windows 启动时自动运行 CipherVault"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource FlatToggleButton}"
                                                  IsChecked="{Binding StartWithWindows}" />
                                </Grid>
                            </Border>

                            <!-- Show tray icon -->
                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="显示托盘图标"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="在系统托盘区域显示图标"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource FlatToggleButton}"
                                                  IsChecked="{Binding ShowTrayIcon}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>

</Window>
