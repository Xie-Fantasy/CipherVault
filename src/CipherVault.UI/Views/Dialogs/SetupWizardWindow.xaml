<Window x:Class="CipherVault.UI.Views.Dialogs.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CipherVault.UI.ViewModels"
        xmlns:conv="clr-namespace:CipherVault.UI.Converters"
        xmlns:h="clr-namespace:CipherVault.UI.Helper"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SetupWizardViewModel}"
        Title="CipherVault 初始化向导"
        Width="640" Height="600"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushBackground}"
        WindowStyle="None"
        AllowsTransparency="False">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInv" IsInverted="True" />
        <conv:EqualToVisibilityConverter x:Key="EqualToVisConverter" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisConverter" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="12"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{DynamicResource BrushBackground}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.15" />
        </Border.Effect>

        <DockPanel Margin="28">
            <!-- Step indicator (top) -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,14,18,12"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- The connector is drawn first so it stays behind the numbered markers. -->
                    <Border Grid.ColumnSpan="4"
                            Height="3"
                            Margin="68,13,68,0"
                            VerticalAlignment="Top"
                            Background="{DynamicResource BrushBorder}"
                            CornerRadius="2" />

                    <StackPanel Grid.Column="0">
                        <Border Width="28" Height="28" CornerRadius="14"
                                HorizontalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                            <Setter Property="Background" Value="{DynamicResource BrushPrimary}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                            <Setter Property="Background" Value="{DynamicResource BrushSuccess}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                            <Setter Property="Background" Value="{DynamicResource BrushSuccess}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                            <Setter Property="Background" Value="{DynamicResource BrushSuccess}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="欢迎" HorizontalAlignment="Center" Margin="0,7,0,0"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Border Width="28" Height="28" CornerRadius="14"
                                HorizontalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                            <Setter Property="Background" Value="{DynamicResource BrushPrimary}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                            <Setter Property="Background" Value="{DynamicResource BrushSuccess}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                            <Setter Property="Background" Value="{DynamicResource BrushSuccess}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="保险库" HorizontalAlignment="Center" Margin="0,7,0,0"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Width="28" Height="28" CornerRadius="14"
                                HorizontalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                            <Setter Property="Background" Value="{DynamicResource BrushPrimary}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                            <Setter Property="Background" Value="{DynamicResource BrushSuccess}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="主密码" HorizontalAlignment="Center" Margin="0,7,0,0"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <Border Width="28" Height="28" CornerRadius="14"
                                HorizontalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                            <Setter Property="Background" Value="{DynamicResource BrushPrimary}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="恢复密钥" HorizontalAlignment="Center" Margin="0,7,0,0"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Navigation buttons (bottom) -->
            <Border DockPanel.Dock="Bottom"
                    Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Back button -->
                    <Button Grid.Column="0"
                            Style="{StaticResource GhostButton}"
                            Content="上一步"
                            Command="{Binding PreviousStepCommand}"
                            IsEnabled="{Binding CanGoBack}"
                            Width="100" />

                    <!-- Cancel button (only on step 1) -->
                    <Button Grid.Column="1"
                            Style="{StaticResource GhostButton}"
                            Content="取消"
                            Command="{Binding CancelCommand}"
                            HorizontalAlignment="Center"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisInv}}" />

                    <!-- Next / Finish button -->
                    <Button Grid.Column="2"
                            Width="120">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                <Setter Property="Content" Value="下一步" />
                                <Setter Property="Command" Value="{Binding NextStepCommand}" />
                                <Setter Property="IsEnabled" Value="{Binding CanGoNext}" />
                                <Setter Property="IsDefault" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="2"
                            Style="{StaticResource FlatButton}"
                            Content="完成创建"
                            Width="120"
                            Command="{Binding FinishCommand}"
                            IsEnabled="{Binding CanFinish}"
                            IsDefault="True"
                            Visibility="{Binding CurrentStep, Converter={StaticResource EqualToVisConverter}, ConverterParameter=4}" />
                </Grid>
            </Border>

            <!-- Error message area -->
            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource BrushDangerSubtle}"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,12,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisConverter}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushDanger}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Step content area -->
            <Grid>
                <!-- Step 1: Welcome -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EqualToVisConverter}, ConverterParameter=1}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Border Width="80" Height="80"
                            CornerRadius="20"
                            Background="{DynamicResource BrushPrimarySubtle}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,24">
                        <h:AppIcon Icon="{x:Static h:Icon.Unlock}"
                                   Size="36"
                                   Foreground="{DynamicResource BrushPrimary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="欢迎使用 CipherVault"
                               FontSize="{DynamicResource FontSizeDisplay}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12" />

                    <TextBlock Text="安全、本地、私密的密码管理器"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />

                    <TextBlock FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0">
                        CipherVault 将在您的电脑上创建一个加密的保险库文件，
                        用于安全地存储您所有的密码和敏感信息。
                    </TextBlock>
                </StackPanel>

                <!-- Step 2: Create vault -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EqualToVisConverter}, ConverterParameter=2}"
                            VerticalAlignment="Center">
                    <TextBlock Text="创建保险库"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               Margin="0,0,0,24" />

                    <!-- Vault name -->
                    <TextBlock Text="保险库名称"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="0,0,0,6" />
                    <TextBox Style="{StaticResource FlatTextBox}"
                             Text="{Binding VaultName, UpdateSourceTrigger=PropertyChanged}"
                             Height="40"
                             Margin="0,0,0,20" />

                    <!-- File location -->
                    <TextBlock Text="存储位置"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource FlatTextBox}"
                                 Text="{Binding VaultFilePath, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Height="40"
                                 Margin="0,0,8,0" />
                        <Button Grid.Column="1"
                                Style="{StaticResource GhostButton}"
                                Content="浏览..."
                                Command="{Binding BrowseLocationCommand}"
                                Width="80" />
                    </Grid>
                    <TextBlock Text="默认保存在“文档\CipherVault”文件夹，可点击“浏览”更改位置。"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               Margin="0,8,0,0" />
                </StackPanel>

                <!-- Step 3: Master password -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EqualToVisConverter}, ConverterParameter=3}"
                            VerticalAlignment="Center">
                    <TextBlock Text="设置主密码"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               Margin="0,0,0,6" />
                    <TextBlock Text="主密码是打开保险库的唯一钥匙，请务必牢记。"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="长度为 6–128 个字符，建议使用容易记住的长口令。"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               Margin="0,0,0,20" />

                    <!-- Password -->
                    <TextBlock Text="主密码"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="0,0,0,6" />
                    <PasswordBox x:Name="SetupPasswordBox"
                                 MaxLength="128"
                                 Height="40"
                                 FontSize="{DynamicResource FontSizePassword}"
                                 Padding="12,8"
                                 PasswordChanged="SetupPasswordBox_PasswordChanged"
                                 Margin="0,0,0,8" />

                    <!-- Password strength meter -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Strength bar -->
                        <Border Grid.Column="0"
                                Height="4"
                                CornerRadius="2"
                                Background="{DynamicResource BrushBorder}"
                                Margin="0,0,8,0">
                            <Border x:Name="StrengthBar"
                                    HorizontalAlignment="Left"
                                    CornerRadius="2"
                                    Height="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource BrushDanger}" />
                                        <Setter Property="Width" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PasswordStrength}" Value="1">
                                                <Setter Property="Background" Value="{DynamicResource BrushDanger}" />
                                                <Setter Property="Width" Value="80" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PasswordStrength}" Value="2">
                                                <Setter Property="Background" Value="{DynamicResource BrushWarning}" />
                                                <Setter Property="Width" Value="160" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PasswordStrength}" Value="3">
                                                <Setter Property="Background" Value="{DynamicResource BrushSuccess}" />
                                                <Setter Property="Width" Value="280" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PasswordStrength}" Value="4">
                                                <Setter Property="Background" Value="{DynamicResource BrushSuccess}" />
                                                <Setter Property="Width" Value="400" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding PasswordStrengthLabel}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Confirm password -->
                    <TextBlock Text="确认主密码"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="0,0,0,6" />
                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 MaxLength="128"
                                 Height="40"
                                 FontSize="{DynamicResource FontSizePassword}"
                                 Padding="12,8"
                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged" />
                </StackPanel>

                <!-- Step 4: Recovery key -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource EqualToVisConverter}, ConverterParameter=4}">
                    <TextBlock Text="保存恢复密钥"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               Margin="0,0,0,6" />
                    <TextBlock Text="请仔细抄写以下 12 个词。如果您忘记主密码，可以使用这些词恢复保险库。"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <!-- Warning -->
                    <Border Background="{DynamicResource BrushWarning}"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <h:AppIcon Icon="{x:Static h:Icon.AlertTriangle}"
                                       Size="16"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="请用手抄写，不要截图或复制！"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="White"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Recovery key display: 4x3 grid of words -->
                    <ItemsControl ItemsSource="{Binding RecoveryKeyDisplay}"
                                  Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" Rows="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BrushSurface}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="9,6"
                                        Margin="3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Index}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextTertiary}"
                                                   Width="20"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Word}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Verification input -->
                    <Border Background="{DynamicResource BrushSurfaceHover}"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       VerticalAlignment="Center">
                                <Run Text="请输入第 " />
                                <Run Text="{Binding VerificationWordNumber, Mode=OneWay}" />
                                <Run Text=" 个恢复词完成验证" />
                            </TextBlock>
                            <TextBox x:Name="VerificationWordTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource FlatTextBox}"
                                     Text="{Binding VerificationWordInput, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36"
                                     Margin="16,0,0,0"
                                     ToolTip="输入上方对应序号的英文恢复词" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Loading overlay -->
                <Border Background="{DynamicResource BrushBackground}"
                        Opacity="0.92"
                        Visibility="{Binding IsCreating, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="正在创建保险库..."
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
