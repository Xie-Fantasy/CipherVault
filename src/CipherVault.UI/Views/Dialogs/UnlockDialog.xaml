<Window x:Class="CipherVault.UI.Views.Dialogs.UnlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CipherVault.UI.ViewModels"
        xmlns:conv="clr-namespace:CipherVault.UI.Converters"
        xmlns:h="clr-namespace:CipherVault.UI.Helper"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:UnlockViewModel}"
        Title="解锁保险库"
        Width="400" Height="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushBackground}"
        WindowStyle="None"
        AllowsTransparency="False">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInv" IsInverted="True" />
        <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisConverter" />
        <conv:GreaterThanZeroToVisibilityConverter x:Key="GreaterThanZeroToVisConverter" />
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="12"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{DynamicResource BrushBackground}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.15" />
        </Border.Effect>

        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Icon -->
                <RowDefinition Height="Auto" />  <!-- Title -->
                <RowDefinition Height="Auto" />  <!-- Vault name -->
                <RowDefinition Height="*" />      <!-- Spacer -->
                <RowDefinition Height="Auto" />  <!-- Password input -->
                <RowDefinition Height="Auto" />  <!-- Error message -->
                <RowDefinition Height="Auto" />  <!-- Lockout -->
                <RowDefinition Height="Auto" />  <!-- Unlock button -->
                <RowDefinition Height="Auto" />  <!-- Windows Hello button -->
                <RowDefinition Height="Auto" />  <!-- Forgot password -->
                <RowDefinition Height="Auto" />  <!-- Failed attempts -->
                <RowDefinition Height="Auto" />  <!-- Cancel -->
            </Grid.RowDefinitions>

            <!-- App icon -->
            <Border Grid.Row="0"
                    Width="64" Height="64"
                    CornerRadius="16"
                    Background="{DynamicResource BrushPrimarySubtle}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,20">
                <h:AppIcon Icon="{x:Static h:Icon.Unlock}"
                           Size="28"
                           Foreground="{DynamicResource BrushPrimary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <!-- Title -->
            <TextBlock Grid.Row="1"
                       Text="解锁保险库"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6" />

            <!-- Vault file name -->
            <TextBlock Grid.Row="2"
                       Text="{Binding VaultFileName}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="300"
                       Margin="0,0,0,24" />

            <!-- Password input -->
            <StackPanel Grid.Row="4" Margin="0,0,0,8">
                <Border Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <PasswordBox x:Name="MasterPasswordBox"
                                 Height="44"
                                 FontSize="{DynamicResource FontSizePassword}"
                                 Padding="14,10"
                                 PasswordChanged="MasterPasswordBox_PasswordChanged"
                                 KeyDown="MasterPasswordBox_KeyDown"
                                 IsEnabled="{Binding IsUnlocking, Converter={StaticResource InverseBoolConverter}}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource BrushTextPrimary}"
                                 CaretBrush="{DynamicResource BrushTextPrimary}" />
                </Border>
            </StackPanel>

            <!-- Error message -->
            <Border Grid.Row="5"
                    Background="{DynamicResource BrushDangerSubtle}"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,8"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisConverter}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushDanger}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Lockout countdown -->
            <Border Grid.Row="6"
                    Background="{DynamicResource BrushWarning}"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,0,0,8"
                    Visibility="{Binding IsLockedOut, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <h:AppIcon Icon="{x:Static h:Icon.AlertTriangle}"
                               Size="16"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock FontSize="{DynamicResource FontSizeBody}"
                               Foreground="White"
                               VerticalAlignment="Center">
                        <Run Text="已锁定，请等待 " />
                        <Run Text="{Binding LockoutCountdown, Mode=OneWay}" />
                        <Run Text=" 秒" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Unlock button -->
            <Button Grid.Row="7"
                    Style="{StaticResource FlatButton}"
                    Content="解锁"
                    Command="{Binding UnlockCommand}"
                    IsEnabled="{Binding IsUnlocking, Converter={StaticResource InverseBoolConverter}}"
                    Height="42"
                    FontSize="{DynamicResource FontSizeSubtitle}"
                    Margin="0,4,0,8" />

            <!-- Windows Hello button -->
            <Button Grid.Row="8"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding WindowsHelloUnlockCommand}"
                    IsEnabled="{Binding IsUnlocking, Converter={StaticResource InverseBoolConverter}}"
                    Height="36"
                    Margin="0,0,0,12"
                    Visibility="{Binding HasStoredHelloKey, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <h:AppIcon Icon="{x:Static h:Icon.Fingerprint}"
                               Size="18"
                               Foreground="{DynamicResource BrushPrimary}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="使用 Windows Hello 解锁"
                               FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource BrushPrimary}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Forgot password link -->
            <Button Grid.Row="9"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding ForgotPasswordCommand}"
                    Padding="0,4"
                    Height="28"
                    HorizontalAlignment="Center">
                <TextBlock Text="忘记主密码？"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushPrimary}"
                           TextDecorations="Underline" />
            </Button>

            <!-- Failed attempts counter -->
            <TextBlock Grid.Row="10"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource BrushTextTertiary}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"
                       Visibility="{Binding FailedAttempts, Converter={StaticResource GreaterThanZeroToVisConverter}}">
                <Run Text="已失败 " />
                <Run Text="{Binding FailedAttempts, Mode=OneWay}" />
                <Run Text=" 次" />
            </TextBlock>

            <!-- Cancel button -->
            <Button Grid.Row="11"
                    Style="{StaticResource GhostButton}"
                    Content="取消"
                    Command="{Binding CancelCommand}"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center" />
        </Grid>
    </Border>
</Window>
