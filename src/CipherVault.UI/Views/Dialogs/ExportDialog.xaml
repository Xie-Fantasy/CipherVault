<Window x:Class="CipherVault.UI.Views.Dialogs.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CipherVault.UI.ViewModels"
        xmlns:conv="clr-namespace:CipherVault.UI.Converters"
        xmlns:h="clr-namespace:CipherVault.UI.Helper"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ExportViewModel}"
        Title="导出保险库"
        Width="500" Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushBackground}"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="12"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:ExportFormatToBoolConverter x:Key="ExportFormatToBool" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{DynamicResource BrushBackground}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.15" />
        </Border.Effect>

        <DockPanel Margin="28">

            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <h:AppIcon Icon="{x:Static h:Icon.Shield}"
                               Size="22"
                               Foreground="{DynamicResource BrushPrimary}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <TextBlock Text="导出保险库"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        Click="CloseButton_Click"
                        ToolTip="关闭">
                    <h:AppIcon Icon="{x:Static h:Icon.X}" Size="14" />
                </Button>
            </Grid>

            <!-- Buttons -->
            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Style="{StaticResource GhostButton}"
                        Content="取消"
                        Command="{Binding CancelCommand}"
                        Width="80"
                        Margin="0,0,8,0" />
                <Button Style="{StaticResource FlatButton}"
                        Content="导出"
                        Command="{Binding ExportCommand}"
                        Width="100"
                        IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBool}}" />
            </StackPanel>

            <!-- Main content -->
            <StackPanel>

                <!-- Format selection label -->
                <TextBlock Text="导出格式"
                           FontSize="{DynamicResource FontSizeCaption}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           Margin="0,0,0,8" />

                <!-- CSV option -->
                <RadioButton GroupName="ExportFormat"
                             IsChecked="{Binding SelectedFormat, Converter={StaticResource ExportFormatToBool}, ConverterParameter=Csv}"
                             Margin="0,0,0,6"
                             Cursor="Hand">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="CSV 文件（明文密码）"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource BrushTextPrimary}" />
                        <TextBlock Text="可被 Excel 等工具打开，密码以明文形式导出"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextTertiary}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </RadioButton>

                <!-- KeePass XML option -->
                <RadioButton GroupName="ExportFormat"
                             IsChecked="{Binding SelectedFormat, Converter={StaticResource ExportFormatToBool}, ConverterParameter=KeePassXml}"
                             Margin="0,0,0,16"
                             Cursor="Hand">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="KeePass XML 格式"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource BrushTextPrimary}" />
                        <TextBlock Text="兼容 KeePass 2.x，包含明文密码"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextTertiary}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </RadioButton>

                <!-- Warning message (visible when CSV selected) -->
                <Border Background="{DynamicResource BrushDangerSubtle}"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,12"
                        Visibility="{Binding WarningMessage, Converter={StaticResource NotEmptyToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <h:AppIcon Icon="{x:Static h:Icon.AlertTriangle}"
                                   Grid.Column="0"
                                   Size="14"
                                   Foreground="{DynamicResource BrushWarning}"
                                   VerticalAlignment="Top"
                                   Margin="0,2,8,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding WarningMessage}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushWarning}"
                                   TextWrapping="Wrap"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="18" />
                    </Grid>
                </Border>

                <!-- File path label -->
                <TextBlock Text="保存位置"
                           FontSize="{DynamicResource FontSizeCaption}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           Margin="0,0,0,6" />

                <!-- File path row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Style="{StaticResource FlatTextBox}"
                             Text="{Binding ExportFilePath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             Margin="0,0,8,0" />

                    <Button Grid.Column="1"
                            Style="{StaticResource GhostButton}"
                            Content="浏览..."
                            Command="{Binding BrowseFileCommand}"
                            Width="88" />
                </Grid>

                <!-- Error message -->
                <Border Background="{DynamicResource BrushDangerSubtle}"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,8"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushDanger}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Progress indicator -->
                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             Margin="0,0,0,8"
                             Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}"
                             Foreground="{DynamicResource BrushPrimary}"
                             Background="{DynamicResource BrushSurfaceHover}" />

                <!-- Success result -->
                <Border Background="{DynamicResource BrushPrimarySubtle}"
                        CornerRadius="6"
                        Padding="12,8"
                        Visibility="{Binding ExportResult, Converter={StaticResource NotEmptyToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <h:AppIcon Icon="{x:Static h:Icon.CheckCircle}"
                                   Size="14"
                                   Foreground="{DynamicResource BrushSuccess}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ExportResult}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushSuccess}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </DockPanel>
    </Border>
</Window>
