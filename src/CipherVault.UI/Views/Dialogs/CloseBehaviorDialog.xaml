<Window x:Class="CipherVault.UI.Views.Dialogs.CloseBehaviorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:CipherVault.UI.Helper"
        Title="关闭 CipherVault"
        Width="600"
        Height="450"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushBackground}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="CloseChoiceRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card"
                                Padding="16"
                                Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="20" Height="20"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0">
                                    <Ellipse Stroke="{DynamicResource BrushTextTertiary}"
                                             StrokeThickness="1.5" />
                                    <Ellipse x:Name="SelectionDot"
                                             Width="10" Height="10"
                                             Fill="{DynamicResource BrushPrimary}"
                                             Opacity="0" />
                                </Grid>
                                <ContentPresenter Grid.Column="1"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource BrushPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource BrushPrimarySubtle}" />
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource BrushPrimary}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                <Setter TargetName="SelectionDot" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="12"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{DynamicResource BrushBackground}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38"
                        CornerRadius="10"
                        Background="{DynamicResource BrushPrimarySubtle}"
                        Margin="0,0,12,0">
                    <h:AppIcon Icon="{x:Static h:Icon.Shield}"
                               Size="19"
                               Foreground="{DynamicResource BrushPrimary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1"
                           Text="关闭 CipherVault"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        Width="34" Height="34"
                        ToolTip="取消"
                        Click="CancelButton_Click">
                    <h:AppIcon Icon="{x:Static h:Icon.X}" Size="13" />
                </Button>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="您希望点击关闭按钮时执行什么操作？"
                       FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       Margin="0,0,0,16" />

            <StackPanel Grid.Row="2">
                <RadioButton x:Name="TrayChoice"
                             GroupName="CloseChoice"
                             Style="{StaticResource CloseChoiceRadioStyle}"
                             IsChecked="True"
                             Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="最小化到系统托盘"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="隐藏主窗口，程序继续在后台运行，可从系统托盘再次打开。"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="ExitChoice"
                             GroupName="CloseChoice"
                             Style="{StaticResource CloseChoiceRadioStyle}">
                    <StackPanel>
                        <TextBlock Text="直接退出程序"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="锁定保险库并完全退出 CipherVault。"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="2,16,0,0">
                <CheckBox x:Name="RememberChoice"
                          Content="记住我的选择"
                          FontSize="{DynamicResource FontSizeBody}"
                          Foreground="{DynamicResource BrushTextPrimary}"
                          Cursor="Hand" />
                <TextBlock Text="以后可在“设置 &gt; 系统托盘”中修改。"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushTextTertiary}"
                           Margin="24,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Style="{StaticResource GhostButton}"
                        Content="取消"
                        Width="92"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click" />
                <Button Style="{StaticResource FlatButton}"
                        Content="确认"
                        Width="112"
                        Click="ConfirmButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
