<Window x:Class="CipherVault.UI.Views.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:h="clr-namespace:CipherVault.UI.Helper"
        mc:Ignorable="d"
        Title="确认"
        Width="400" Height="200"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushBackground}"
        WindowStyle="None"
        AllowsTransparency="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="12"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{DynamicResource BrushBackground}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.15" />
        </Border.Effect>

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Icon + Title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <h:AppIcon x:Name="IconText"
                           Icon="{x:Static h:Icon.AlertTriangle}"
                           Size="24"
                           Foreground="{DynamicResource BrushWarning}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <TextBlock x:Name="TitleText"
                           Text="确认操作"
                           FontSize="{DynamicResource FontSizeSubtitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Message -->
            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Text="您确定要执行此操作吗？"
                       FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Style="{StaticResource GhostButton}"
                        x:Name="CancelButton"
                        Content="取消"
                        Click="CancelButton_Click"
                        Width="80"
                        Margin="0,0,8,0" />
                <Button x:Name="ConfirmButton"
                        Style="{StaticResource FlatButton}"
                        Content="确认"
                        Click="ConfirmButton_Click"
                        Width="100" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

