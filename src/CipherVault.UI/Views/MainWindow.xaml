<Window x:Class="CipherVault.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CipherVault.UI.ViewModels"
        xmlns:controls="clr-namespace:CipherVault.UI.Views.Controls"
        xmlns:conv="clr-namespace:CipherVault.UI.Converters"
        xmlns:loc="clr-namespace:CipherVault.UI.Localization"
        xmlns:h="clr-namespace:CipherVault.UI.Helper"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="CipherVault"
        Width="1100" Height="720"
        MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBackground}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInv" IsInverted="True" />
        <conv:LocalizedValueConverter x:Key="LocalizedValue" />
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      CornerRadius="8"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />  <!-- Title bar -->
            <RowDefinition Height="44" />  <!-- Toolbar -->
            <RowDefinition Height="*" />   <!-- Content -->
            <RowDefinition Height="Auto" /><!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ==================== Title Bar ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0" VerticalAlignment="Center">

                <!-- Window controls (right) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Margin="8,0,0,0">
                    <Button Style="{StaticResource IconButton}" Width="40" Height="32"
                            Click="MinimizeButton_Click" ToolTip="最小化">
                        <h:AppIcon Icon="{x:Static h:Icon.Minus}" Size="14" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="40" Height="32"
                            Click="MaximizeButton_Click" ToolTip="最大化">
                        <h:AppIcon x:Name="MaximizeIconCtrl" Icon="{x:Static h:Icon.Square}" Size="12" />
                    </Button>
                    <Button x:Name="CloseButton" Width="40" Height="32"
                            Click="CloseButton_Click" ToolTip="关闭" Cursor="Hand"
                            Foreground="{DynamicResource BrushTextPrimary}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="0,6,0,0">
                                    <h:AppIcon Icon="{x:Static h:Icon.X}" Size="14" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushDanger}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextInverse}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- App icon + vault selector (left, fills remaining space) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <h:AppIcon Icon="{x:Static h:Icon.Shield}" Size="18"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               Margin="0,0,10,0" />
                    <ComboBox ItemsSource="{Binding VaultListVM.Vaults}"
                              SelectedItem="{Binding VaultListVM.SelectedVault}"
                              Width="140" Height="28"
                              FontSize="{DynamicResource FontSizeBody}"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizedValue}">
                                            <Binding Path="Name" />
                                            <Binding Source="{x:Static loc:LocalizationManager.Instance}"
                                                     Path="LanguageVersion" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== Toolbar ==================== -->
        <Border Grid.Row="1" Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0" VerticalAlignment="Center">

                <!-- Right-side action buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="设置" Margin="2,0">
                        <h:AppIcon Icon="{x:Static h:Icon.Settings}" Size="16" />
                    </Button>

                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding ImportVaultCommand}"
                            ToolTip="导入密码" Margin="2,0">
                        <h:AppIcon Icon="{x:Static h:Icon.FileUp}" Size="16" />
                    </Button>

                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding ExportVaultCommand}"
                            ToolTip="导出保险库" Margin="2,0">
                        <h:AppIcon Icon="{x:Static h:Icon.Download}" Size="16" />
                    </Button>

                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding RestoreBackupCommand}"
                            ToolTip="恢复备份" Margin="2,0">
                        <h:AppIcon Icon="{x:Static h:Icon.History}" Size="16" />
                    </Button>

                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding LockVaultCommand}"
                            ToolTip="锁定保险库" Margin="2,0">
                        <h:AppIcon Icon="{x:Static h:Icon.Lock}" Size="16" />
                    </Button>
                </StackPanel>

                <!-- Search bar (fills remaining space) -->
                <controls:SearchBarControl x:Name="MainSearchBar"
                                           SearchQuery="{Binding EntryListVM.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Width="360" MaxWidth="400"
                                           HorizontalAlignment="Left"
                                           Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <!-- ==================== Main Content (3-column layout) ==================== -->
        <Grid Grid.Row="2" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisInv}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{Binding EntryListWidth}" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Left panel: Vault tree / navigation -->
            <controls:VaultTreeView Grid.Column="0"
                                    DataContext="{Binding VaultListVM}" />

            <!-- Left splitter -->
            <GridSplitter Grid.Column="1" Width="1"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource BrushBorder}"
                          ResizeBehavior="PreviousAndNext" />

            <!-- Center panel: Entry list -->
            <controls:EntryListControl Grid.Column="2"
                                       DataContext="{Binding EntryListVM}" />

            <!-- Right splitter -->
            <GridSplitter Grid.Column="3" Width="1"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource BrushBorder}"
                          ResizeBehavior="PreviousAndNext" />

            <!-- Right panel: Entry detail -->
            <controls:EntryDetailPanel Grid.Column="4"
                                       DataContext="{Binding EntryDetailVM}" />
        </Grid>

        <!-- ==================== Lock Overlay ==================== -->
        <Border Grid.Row="2"
                Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource BrushBackground}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="36"
                        Background="{DynamicResource BrushSurfaceHover}"
                        HorizontalAlignment="Center" Margin="0,0,0,20">
                    <h:AppIcon Icon="{x:Static h:Icon.Lock}" Size="32"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="保险库已锁定"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />
                <TextBlock Text="点击解锁以访问您的密码"
                           FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource FlatButton}"
                            Content="解锁保险库"
                            MinWidth="132" Margin="0,0,10,0"
                            Command="{Binding UnlockVaultCommand}" />
                    <Button Style="{StaticResource GhostButton}"
                            Content="打开其他保险库"
                            MinWidth="132"
                            Command="{Binding SwitchVaultCommand}" />
                </StackPanel>
                <Button Style="{StaticResource GhostButton}"
                        Content="新建保险库"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding OpenSetupWizardCommand}" />
            </StackPanel>
        </Border>

        <!-- ==================== Status Bar ==================== -->
        <controls:StatusBarControl Grid.Row="3"
                                   DataContext="{Binding}" />
    </Grid>
</Window>
