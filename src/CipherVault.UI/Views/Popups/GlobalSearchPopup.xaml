<Window x:Class="CipherVault.UI.Views.Popups.GlobalSearchPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CipherVault.UI.ViewModels"
        xmlns:conv="clr-namespace:CipherVault.UI.Converters"
        xmlns:h="clr-namespace:CipherVault.UI.Helper"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:GlobalSearchViewModel}"
        Title="快速搜索"
        Width="560" Height="400"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="False"
        Topmost="True"
        ShowActivated="True">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:CredentialTypeToIconConverter x:Key="TypeToIcon" />
    </Window.Resources>

    <Border CornerRadius="8"
            Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="4" BlurRadius="24" Opacity="0.2"
                              Color="#000000" />
        </Border.Effect>

        <DockPanel>
            <!-- Search input (top) -->
            <Border DockPanel.Dock="Top"
                    Padding="16,12"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <!-- Search icon -->
                    <ContentControl Foreground="{DynamicResource BrushTextTertiary}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Margin="12,0,0,0"
                                    IsHitTestVisible="False"
                                    Focusable="False">
                        <h:AppIcon Icon="{x:Static h:Icon.Search}" Size="18" />
                    </ContentControl>

                    <!-- Search text box -->
                    <TextBox x:Name="SearchInput"
                             Style="{StaticResource FlatTextBox}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Padding="40,10,12,10"
                             FontSize="{DynamicResource FontSizeSubtitle}"
                             BorderThickness="0"
                             Background="Transparent"
                             Height="44"
                             KeyDown="SearchInput_KeyDown" />

                    <!-- Placeholder -->
                    <TextBlock Text="搜索条目..."
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="42,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Results list -->
            <ListView Style="{StaticResource FlatListView}"
                      ItemsSource="{Binding Results}"
                      SelectedItem="{Binding SelectedEntry}"
                      ItemContainerStyle="{StaticResource FlatListViewItem}"
                      SelectionMode="Single"
                      Margin="4"
                      KeyDown="SearchInput_KeyDown">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Credential type icon -->
                            <Border Grid.Column="0"
                                    Width="32" Height="32"
                                    CornerRadius="6"
                                    Background="{DynamicResource BrushPrimarySubtle}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                                <ContentControl Foreground="{DynamicResource BrushPrimary}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Focusable="False">
                                    <h:AppIcon Icon="{Binding CredentialType, Converter={StaticResource TypeToIcon}}" Size="14" />
                                </ContentControl>
                            </Border>

                            <!-- Title + domain -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Url}"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Favorite indicator -->
                            <ContentControl Grid.Column="2"
                                            Foreground="{DynamicResource BrushFavorite}"
                                            VerticalAlignment="Center"
                                            Margin="8,0,4,0"
                                            Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"
                                            Focusable="False">
                                <h:AppIcon Icon="{x:Static h:Icon.Star}" Size="12" />
                            </ContentControl>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Bottom hint bar -->
            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource BrushSurfaceHover}"
                    CornerRadius="0,0,8,8"
                    Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Copy mode indicator -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BrushPrimarySubtle}"
                                CornerRadius="4"
                                Padding="8,3"
                                Margin="0,0,8,0">
                            <TextBlock x:Name="CopyModeText"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource BrushPrimary}"
                                       FontWeight="Medium">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="复制密码" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CopyMode}" Value="Username">
                                                <Setter Property="Text" Value="复制账号" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- Keyboard shortcuts -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="6,2"
                                Margin="0,0,4,0">
                            <TextBlock Text="Tab"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       FontFamily="{StaticResource FontMono}"
                                       Foreground="{DynamicResource BrushTextTertiary}" />
                        </Border>
                        <TextBlock Text="切换模式"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource BrushTextTertiary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />

                        <Border Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="6,2"
                                Margin="0,0,4,0">
                            <TextBlock Text="Enter"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       FontFamily="{StaticResource FontMono}"
                                       Foreground="{DynamicResource BrushTextTertiary}" />
                        </Border>
                        <TextBlock Text="复制"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource BrushTextTertiary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />

                        <Border Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="6,2"
                                Margin="0,0,4,0">
                            <TextBlock Text="Esc"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       FontFamily="{StaticResource FontMono}"
                                       Foreground="{DynamicResource BrushTextTertiary}" />
                        </Border>
                        <TextBlock Text="关闭"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource BrushTextTertiary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</Window>
