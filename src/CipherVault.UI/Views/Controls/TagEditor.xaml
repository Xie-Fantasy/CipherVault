<UserControl x:Class="CipherVault.UI.Views.Controls.TagEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:CipherVault.UI.Converters"
             xmlns:h="clr-namespace:CipherVault.UI.Helper"
             mc:Ignorable="d"
             d:DesignWidth="400" d:DesignHeight="60"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInv" IsInverted="True" />
    </UserControl.Resources>

    <WrapPanel>
        <!-- Existing tags -->
        <ItemsControl ItemsSource="{Binding Tags, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource BrushPrimarySubtle}"
                            CornerRadius="12"
                            Padding="10,4"
                            Margin="0,0,6,6"
                            Height="26">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource BrushPrimary}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <!-- Remove button (only in edit mode) -->
                            <Button Style="{StaticResource IconButton}"
                                    Width="16" Height="16"
                                    Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                    Click="RemoveTag_Click"
                                    Tag="{Binding}"
                                    Padding="0">
                                <h:AppIcon Icon="{x:Static h:Icon.X}" Size="8" />
                            </Button>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Add tag button (only in edit mode) -->
        <Grid Visibility="{Binding IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
              Margin="0,0,0,6">
            <!-- Add button -->
            <Button x:Name="AddTagButton"
                    Style="{StaticResource GhostButton}"
                    Padding="8,4"
                    Height="26"
                    Click="AddTagButton_Click">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center" Margin="0,0,4,0">
                        <h:AppIcon Icon="{x:Static h:Icon.Plus}" Size="10" />
                    </ContentControl>
                    <TextBlock Text="添加标签"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource BrushPrimary}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Inline tag input -->
            <Grid x:Name="TagInputPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="NewTagInput"
                         Style="{StaticResource FlatTextBox}"
                         Height="26"
                         Padding="8,4"
                         FontSize="{DynamicResource FontSizeCaption}"
                         KeyDown="NewTagInput_KeyDown" />

                <Button Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        Width="24" Height="24"
                        Click="ConfirmTag_Click"
                        ToolTip="确认"
                        Margin="4,0,0,0">
                    <h:AppIcon Icon="{x:Static h:Icon.Check}" Size="12" />
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        Width="24" Height="24"
                        Click="CancelTag_Click"
                        ToolTip="取消"
                        Margin="2,0,0,0">
                    <h:AppIcon Icon="{x:Static h:Icon.X}" Size="12" />
                </Button>
            </Grid>
        </Grid>
    </WrapPanel>
</UserControl>

