<UserControl x:Class="CipherVault.UI.Views.Controls.EntryListControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CipherVault.UI.ViewModels"
             xmlns:controls="clr-namespace:CipherVault.UI.Views.Controls"
             xmlns:conv="clr-namespace:CipherVault.UI.Converters"
             xmlns:loc="clr-namespace:CipherVault.UI.Localization"
             xmlns:h="clr-namespace:CipherVault.UI.Helper"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EntryListViewModel}"
             Background="{DynamicResource BrushBackground}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInv" IsInverted="True" />
        <conv:CredentialTypeToIconConverter x:Key="TypeToIcon" />
        <conv:LocalizedFormatConverter x:Key="LocalizedFormat" />
        <conv:LocalizedValueConverter x:Key="LocalizedValue" />

        <Style x:Key="SortChoiceButton"
               TargetType="Button"
               BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="116" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        </Style>

        <Style x:Key="BulkActionButton"
               TargetType="Button"
               BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Top toolbar: search + sort + add -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="密码条目"
                               FontSize="{DynamicResource FontSizeBody}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBlock FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               Margin="0,2,0,0">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocalizedFormat}"
                                          ConverterParameter="{}{0} 项">
                                <Binding Path="FilteredCount" />
                                <Binding Source="{x:Static loc:LocalizationManager.Instance}"
                                         Path="LanguageVersion" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <!-- Sort button -->
                <Button x:Name="SortButton"
                        Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        Click="SortButton_Click"
                        Margin="0,0,4,0">
                    <Button.ToolTip>
                        <MultiBinding Converter="{StaticResource LocalizedValue}">
                            <Binding Path="SortDescription" />
                            <Binding Source="{x:Static loc:LocalizationManager.Instance}"
                                     Path="LanguageVersion" />
                        </MultiBinding>
                    </Button.ToolTip>
                    <h:AppIcon Icon="{x:Static h:Icon.ArrowUpDown}" Size="16" />
                </Button>

                <Popup x:Name="SortPopup"
                       Grid.Column="1"
                       PlacementTarget="{Binding ElementName=SortButton}"
                       Placement="Bottom"
                       HorizontalOffset="-236"
                       VerticalOffset="4"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       DataContext="{Binding DataContext, ElementName=Root}">
                    <Border Width="286"
                            Padding="14"
                            CornerRadius="10"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18"
                                              ShadowDepth="5"
                                              Opacity="0.2"
                                              Color="#000000" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="排序方式"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="按修改时间"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,0,0,7" />
                            <UniformGrid Columns="2" Margin="0,0,0,13">
                                <Button Content="从新到旧"
                                        Command="{Binding SetSortModeCommand}"
                                        CommandParameter="{x:Static vm:EntrySortMode.ModifiedDescending}"
                                        Click="SortOptionButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SortChoiceButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SortMode}"
                                                             Value="{x:Static vm:EntrySortMode.ModifiedDescending}">
                                                    <Setter Property="Background" Value="{DynamicResource BrushPrimarySubtle}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="从旧到新"
                                        Margin="0"
                                        Command="{Binding SetSortModeCommand}"
                                        CommandParameter="{x:Static vm:EntrySortMode.ModifiedAscending}"
                                        Click="SortOptionButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SortChoiceButton}">
                                            <Setter Property="Margin" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SortMode}"
                                                             Value="{x:Static vm:EntrySortMode.ModifiedAscending}">
                                                    <Setter Property="Background" Value="{DynamicResource BrushPrimarySubtle}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>

                            <TextBlock Text="按创建时间"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,0,0,7" />
                            <UniformGrid Columns="2" Margin="0,0,0,13">
                                <Button Content="从新到旧"
                                        Command="{Binding SetSortModeCommand}"
                                        CommandParameter="{x:Static vm:EntrySortMode.CreatedDescending}"
                                        Click="SortOptionButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SortChoiceButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SortMode}"
                                                             Value="{x:Static vm:EntrySortMode.CreatedDescending}">
                                                    <Setter Property="Background" Value="{DynamicResource BrushPrimarySubtle}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="从旧到新"
                                        Command="{Binding SetSortModeCommand}"
                                        CommandParameter="{x:Static vm:EntrySortMode.CreatedAscending}"
                                        Click="SortOptionButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SortChoiceButton}">
                                            <Setter Property="Margin" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SortMode}"
                                                             Value="{x:Static vm:EntrySortMode.CreatedAscending}">
                                                    <Setter Property="Background" Value="{DynamicResource BrushPrimarySubtle}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>

                            <TextBlock Text="按名称"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,0,0,7" />
                            <UniformGrid Columns="2">
                                <Button Content="从 A 到 Z"
                                        Command="{Binding SetSortModeCommand}"
                                        CommandParameter="{x:Static vm:EntrySortMode.NameAscending}"
                                        Click="SortOptionButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SortChoiceButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SortMode}"
                                                             Value="{x:Static vm:EntrySortMode.NameAscending}">
                                                    <Setter Property="Background" Value="{DynamicResource BrushPrimarySubtle}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="从 Z 到 A"
                                        Command="{Binding SetSortModeCommand}"
                                        CommandParameter="{x:Static vm:EntrySortMode.NameDescending}"
                                        Click="SortOptionButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SortChoiceButton}">
                                            <Setter Property="Margin" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SortMode}"
                                                             Value="{x:Static vm:EntrySortMode.NameDescending}">
                                                    <Setter Property="Background" Value="{DynamicResource BrushPrimarySubtle}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Favorites filter toggle -->
                <ToggleButton Grid.Column="2"
                              Style="{StaticResource IconToggleButton}"
                              Width="32" Height="32"
                              IsChecked="{Binding ShowFavoritesOnly}"
                              ToolTip="仅显示收藏"
                              Margin="0,0,4,0">
                    <h:AppIcon Icon="{x:Static h:Icon.Star}" Size="16" />
                </ToggleButton>

                <!-- Enter bulk mode by selecting all visible entries -->
                <ToggleButton Grid.Column="3"
                        Style="{StaticResource IconToggleButton}"
                        IsChecked="{Binding IsBulkMode}"
                        Click="BulkModeButton_Click"
                        ToolTip="批量管理"
                        Margin="0,0,4,0">
                    <h:AppIcon Icon="{x:Static h:Icon.CheckCircle}" Size="17" />
                </ToggleButton>

                <!-- Add button -->
                <Button Grid.Column="4"
                        Style="{StaticResource IconButton}"
                        Command="{Binding AddEntryCommand}"
                        ToolTip="新建条目 (Ctrl+N)">
                    <h:AppIcon Icon="{x:Static h:Icon.Plus}" Size="18" />
                </Button>
            </Grid>
        </Border>

        <!-- Contextual bulk-management toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="12,10"
                Visibility="{Binding IsBulkMode, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource BrushPrimarySubtle}"
                            CornerRadius="14"
                            Padding="9,5"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <h:AppIcon Icon="{x:Static h:Icon.CheckCircle}"
                                       Size="14"
                                       Foreground="{DynamicResource BrushPrimary}"
                                       Margin="0,0,6,0" />
                            <TextBlock VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource BrushPrimary}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocalizedFormat}"
                                                  ConverterParameter="已选择 {0} 项">
                                        <Binding Path="SelectedCount" />
                                        <Binding Source="{x:Static loc:LocalizationManager.Instance}"
                                                 Path="LanguageVersion" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="1"
                            Style="{StaticResource GhostButton}"
                            Content="全选"
                            Click="SelectAllButton_Click"
                            Height="28"
                            Padding="7,2"
                            Margin="0,0,4,0"
                            FontSize="{DynamicResource FontSizeSmall}" />
                    <Button Grid.Column="2"
                            Style="{StaticResource GhostButton}"
                            Content="清除选择"
                            Click="ClearSelectionButton_Click"
                            Height="28"
                            Padding="7,2"
                            FontSize="{DynamicResource FontSizeSmall}" />
                    <Button Grid.Column="3"
                            Style="{StaticResource IconButton}"
                            Click="ExitBulkModeButton_Click"
                            ToolTip="退出批量管理"
                            Width="28"
                            Height="28"
                            Margin="3,0,0,0">
                        <h:AppIcon Icon="{x:Static h:Icon.X}" Size="13" />
                    </Button>
                </Grid>

                <StackPanel Visibility="{Binding IsTrashView, Converter={StaticResource BoolToVisInv}}">
                    <UniformGrid Columns="3" Margin="0,0,0,8">
                        <Button Style="{StaticResource BulkActionButton}"
                                Command="{Binding FavoriteSelectedCommand}"
                                IsEnabled="{Binding HasSelection}"
                                Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <h:AppIcon Icon="{x:Static h:Icon.Star}" Size="14" Margin="0,0,6,0" />
                                <TextBlock Text="设为收藏" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BulkActionButton}"
                                Command="{Binding UnfavoriteSelectedCommand}"
                                IsEnabled="{Binding HasSelection}"
                                Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <h:AppIcon Icon="{x:Static h:Icon.Star}" Size="14" Margin="0,0,6,0" />
                                <TextBlock Text="取消收藏" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BulkActionButton}"
                                Click="DeleteSelectedButton_Click"
                                IsEnabled="{Binding HasSelection}"
                                Foreground="{DynamicResource BrushDanger}">
                            <StackPanel Orientation="Horizontal">
                                <h:AppIcon Icon="{x:Static h:Icon.Trash2}" Size="14" Margin="0,0,6,0" />
                                <TextBlock Text="移到回收站" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="移动到"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableGroups}"
                                  SelectedItem="{Binding SelectedBulkGroup}"
                                  Height="34"
                                  MinWidth="120"
                                  Margin="0,0,6,0"
                                  ToolTip="选择目标分组">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="2"
                                Style="{StaticResource BulkActionButton}"
                                Content="移动"
                                Command="{Binding MoveSelectedCommand}"
                                IsEnabled="{Binding HasSelection}"
                                MinWidth="58" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="添加标签"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <Grid Grid.Column="1" Margin="0,0,6,0">
                            <ComboBox ItemsSource="{Binding AvailableTags}"
                                      SelectedItem="{Binding SelectedBulkTag}"
                                      Height="34"
                                      MinWidth="120"
                                      ToolTip="选择要添加的标签">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="11,0,28,0"
                                       Foreground="{DynamicResource BrushTextTertiary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="选择标签" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedBulkTag}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AvailableTags.Count}" Value="0">
                                                <Setter Property="Text" Value="暂无标签" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Column="2"
                                Style="{StaticResource BulkActionButton}"
                                Content="添加"
                                Command="{Binding AddTagToSelectedCommand}"
                                IsEnabled="{Binding HasSelection}"
                                MinWidth="58" />
                    </Grid>
                </StackPanel>

                <UniformGrid Columns="2"
                             Visibility="{Binding IsTrashView, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource BulkActionButton}"
                            Command="{Binding RestoreSelectedCommand}"
                            IsEnabled="{Binding HasSelection}"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <h:AppIcon Icon="{x:Static h:Icon.Undo2}" Size="14" Margin="0,0,6,0" />
                            <TextBlock Text="恢复所选" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BulkActionButton}"
                            Click="PermanentlyDeleteSelectedButton_Click"
                            Foreground="{DynamicResource BrushDanger}"
                            IsEnabled="{Binding HasSelection}">
                        <StackPanel Orientation="Horizontal">
                            <h:AppIcon Icon="{x:Static h:Icon.Trash2}" Size="14" Margin="0,0,6,0" />
                            <TextBlock Text="永久删除" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BrushDangerSubtle}"
                BorderBrush="{DynamicResource BrushDanger}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="10,8,10,0"
                Padding="10,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding OperationErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding OperationErrorMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding OperationErrorMessage}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushDanger}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Button Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        Command="{Binding DismissOperationErrorCommand}"
                        ToolTip="关闭"
                        Width="26"
                        Height="26">
                    <h:AppIcon Icon="{x:Static h:Icon.X}" Size="12" />
                </Button>
            </Grid>
        </Border>

        <!-- Entry list -->
        <Grid>
        <ListView x:Name="EntriesList"
                  Style="{StaticResource FlatListView}"
                  ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding SelectedEntry}"
                  ItemContainerStyle="{StaticResource FlatListViewItem}"
                  SelectionMode="Extended"
                  SelectionChanged="EntriesList_SelectionChanged"
                  Margin="8,4">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True"
                                            VirtualizingPanel.VirtualizationMode="Recycling" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Margin="0,0,9,0"
                                  IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}, Mode=TwoWay}"
                                  Visibility="{Binding DataContext.IsBulkMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                  ToolTip="选择此条目" />

                        <!-- Website/title initial -->
                        <controls:EntryIcon Grid.Column="1"
                                            Width="32" Height="32"
                                            Title="{Binding Title}"
                                            Url="{Binding Url}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0" />

                        <!-- Title + username -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="220" />
                            <TextBlock Text="{Binding Username}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="220"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Favorite star -->
                        <h:AppIcon Grid.Column="3"
                                   Icon="{x:Static h:Icon.Star}"
                                   Size="12"
                                   IsFilled="True"
                                   Foreground="{DynamicResource BrushFavorite}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsHitTestVisible="False">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems, ElementName=EntriesList}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <h:AppIcon Icon="{x:Static h:Icon.Search}" Size="32"
                       Foreground="{DynamicResource BrushTextTertiary}"
                       HorizontalAlignment="Center" Margin="0,0,0,12" />
            <TextBlock Text="没有匹配的条目"
                       FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="调整搜索条件，或点击右上角＋新建"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource BrushTextTertiary}"
                       HorizontalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
