<UserControl x:Class="CipherVault.UI.Views.Controls.EntryIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="Transparent"
             IsHitTestVisible="False">
    <Border x:Name="IconSurface"
            Background="{DynamicResource BrushPrimarySubtle}"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid>
            <TextBlock x:Name="FallbackLetter"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushPrimary}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
