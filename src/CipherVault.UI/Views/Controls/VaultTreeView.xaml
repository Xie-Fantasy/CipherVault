<UserControl x:Class="CipherVault.UI.Views.Controls.VaultTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CipherVault.UI.ViewModels"
             xmlns:h="clr-namespace:CipherVault.UI.Helper"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VaultListViewModel}"
             Background="{DynamicResource BrushSurface}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <DockPanel>
        <!-- Bottom: Add group button -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="8">
            <Grid>
            <Button x:Name="AddGroupButton"
                    Style="{StaticResource GhostButton}"
                    Click="AddGroupButton_Click"
                    HorizontalContentAlignment="Left"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <h:AppIcon Icon="{x:Static h:Icon.Plus}" Size="14"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="新建分组"
                               FontSize="{DynamicResource FontSizeCaption}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Grid x:Name="AddGroupPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="GroupNameInput" Style="{StaticResource FlatTextBox}"
                         Height="32" KeyDown="GroupNameInput_KeyDown" />
                <Button Grid.Column="1" Style="{StaticResource IconButton}"
                        Click="ConfirmAddGroup_Click" ToolTip="确认" Margin="4,0,0,0">
                    <h:AppIcon Icon="{x:Static h:Icon.Check}" Size="12" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                        Click="CancelAddGroup_Click" ToolTip="取消" Margin="2,0,0,0">
                    <h:AppIcon Icon="{x:Static h:Icon.X}" Size="12" />
                </Button>
            </Grid>
            </Grid>
        </Border>

        <!-- Scrollable content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="8,4">
            <StackPanel>
                <!-- Special view: All -->
                <Button Command="{Binding SelectSpecialViewCommand}"
                        CommandParameter="All"
                        HorizontalContentAlignment="Left"
                        Padding="12,10"
                        Margin="0,1">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SpecialView}" Value="All">
                                    <Setter Property="Background" Value="{DynamicResource BrushPrimarySubtle}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <h:AppIcon Icon="{x:Static h:Icon.Folder}" Size="16"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBlock Text="全部"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Special view: Favorites -->
                <Button Command="{Binding SelectSpecialViewCommand}"
                        CommandParameter="Favorites"
                        HorizontalContentAlignment="Left"
                        Padding="12,10"
                        Margin="0,1">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SpecialView}" Value="Favorites">
                                    <Setter Property="Background" Value="{DynamicResource BrushPrimarySubtle}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <h:AppIcon Icon="{x:Static h:Icon.Star}" Size="16"
                                   Foreground="{DynamicResource BrushFavorite}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBlock Text="收藏"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Special view: Recent -->
                <Button Command="{Binding SelectSpecialViewCommand}"
                        CommandParameter="Recent"
                        HorizontalContentAlignment="Left"
                        Padding="12,10"
                        Margin="0,1">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SpecialView}" Value="Recent">
                                    <Setter Property="Background" Value="{DynamicResource BrushPrimarySubtle}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <h:AppIcon Icon="{x:Static h:Icon.Clock}" Size="16"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBlock Text="最近"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Special view: Trash -->
                <Button Command="{Binding SelectSpecialViewCommand}"
                        CommandParameter="Trash"
                        HorizontalContentAlignment="Left"
                        Padding="12,10"
                        Margin="0,1">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SpecialView}" Value="Trash">
                                    <Setter Property="Background" Value="{DynamicResource BrushPrimarySubtle}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <h:AppIcon Icon="{x:Static h:Icon.Trash2}" Size="16"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBlock Text="回收站"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Separator -->
                <Border Height="1"
                        Background="{DynamicResource BrushBorder}"
                        Margin="12,8" />

                <!-- Groups header -->
                <TextBlock Text="分组"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource BrushTextTertiary}"
                           Margin="12,4,12,4" />

                <!-- Groups tree -->
                <TreeView x:Name="GroupsTree"
                          ItemsSource="{Binding Groups}"
                          SelectedItemChanged="GroupsTree_SelectedItemChanged"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal"
                                        Margin="4,4">
                                <h:AppIcon Icon="{x:Static h:Icon.Folder}" Size="14"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="新建子分组" Click="AddChildGroupMenu_Click" />
                            <MenuItem Header="重命名" Click="RenameGroupMenu_Click" />
                            <Separator />
                            <MenuItem Header="删除分组" Click="DeleteGroupMenu_Click" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
