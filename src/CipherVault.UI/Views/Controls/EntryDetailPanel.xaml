<UserControl x:Class="CipherVault.UI.Views.Controls.EntryDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CipherVault.UI.ViewModels"
             xmlns:controls="clr-namespace:CipherVault.UI.Views.Controls"
             xmlns:conv="clr-namespace:CipherVault.UI.Converters"
             xmlns:loc="clr-namespace:CipherVault.UI.Localization"
             xmlns:h="clr-namespace:CipherVault.UI.Helper"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EntryDetailViewModel}"
             Background="{DynamicResource BrushBackground}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInv" IsInverted="True" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:CredentialTypeToIconConverter x:Key="TypeToIcon" />
        <conv:CredentialTypeDisplayConverter x:Key="CredentialTypeDisplay" />
        <conv:PasswordMaskConverter x:Key="PasswordMask" />
        <conv:NullToVisibilityConverter x:Key="NullToVisConverter" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisConverter" />
    </UserControl.Resources>

    <Grid>
        <!-- Placeholder when no entry selected -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding CurrentEntry, Converter={StaticResource NullToVisConverter}}">
            <h:AppIcon Icon="{x:Static h:Icon.Shield}" Size="48"
                       Foreground="{DynamicResource BrushTextTertiary}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12" />
            <TextBlock Text="选择一个条目查看详情"
                       FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource BrushTextTertiary}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Entry detail content -->
        <DockPanel Visibility="{Binding CurrentEntry, Converter={StaticResource NotNullToVisConverter}}">

            <!-- Bottom toolbar -->
            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInv}}">
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding ToggleEditCommand}"
                            Visibility="{Binding IsCurrentEntryDeleted, Converter={StaticResource BoolToVisInv}}"
                            Padding="12,8"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <h:AppIcon Icon="{x:Static h:Icon.Pencil}" Size="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="编辑" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}"
                            Click="DeleteButton_Click"
                            Visibility="{Binding IsCurrentEntryDeleted, Converter={StaticResource BoolToVisInv}}"
                            Foreground="{DynamicResource BrushDanger}"
                            Padding="12,8"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <h:AppIcon Icon="{x:Static h:Icon.Trash2}" Size="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="删除" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding RestoreDeletedCommand}"
                            Visibility="{Binding IsCurrentEntryDeleted, Converter={StaticResource BoolToVis}}"
                            Padding="12,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <h:AppIcon Icon="{x:Static h:Icon.Undo2}" Size="14"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="恢复" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}"
                            Click="PermanentDeleteButton_Click"
                            Visibility="{Binding IsCurrentEntryDeleted, Converter={StaticResource BoolToVis}}"
                            Foreground="{DynamicResource BrushDanger}"
                            Padding="12,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <h:AppIcon Icon="{x:Static h:Icon.Trash2}" Size="14"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="永久删除" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding ViewHistoryCommand}"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <h:AppIcon Icon="{x:Static h:Icon.History}" Size="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="历史" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    </StackPanel>

                    <!-- Edit mode buttons (right-aligned) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding CancelEditCommand}"
                                Content="取消"
                                Padding="16,8"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource FlatButton}"
                                Command="{Binding SaveCommand}"
                                Content="保存"
                                Padding="16,8" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Scrollable content area -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="24,20">
                <StackPanel>
                    <Border Background="{DynamicResource BrushDangerSubtle}"
                            BorderBrush="{DynamicResource BrushDanger}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="10,8"
                            Margin="0,0,0,14"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVisConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource BrushDanger}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Header: Icon + Title + Favorite -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Website/title initial -->
                        <controls:EntryIcon Grid.Column="0"
                                            Width="44" Height="44"
                                            Title="{Binding CurrentEntry.Title}"
                                            Url="{Binding CurrentEntry.Url}"
                                            Margin="0,0,14,0" />

                        <!-- Title -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <!-- Read mode title -->
                            <TextBlock Text="{Binding CurrentEntry.Title}"
                                       FontSize="{DynamicResource FontSizeTitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInv}}" />
                            <!-- Edit mode title -->
                            <TextBox Style="{StaticResource FlatTextBox}"
                                     Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="{DynamicResource FontSizeTitle}"
                                     FontWeight="SemiBold"
                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                            <ComboBox x:Name="CredentialTypeComboBox"
                                      ItemsSource="{Binding CredentialTypes}"
                                      SelectedItem="{Binding EditCredentialType}"
                                      Margin="0,6,0,0"
                                      Height="30"
                                      Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource CredentialTypeDisplay}">
                                                    <Binding />
                                                    <Binding Source="{x:Static loc:LocalizationManager.Instance}"
                                                             Path="LanguageVersion" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Favorite toggle -->
                        <Button Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                Command="{Binding ToggleFavoriteCommand}"
                                Visibility="{Binding IsCurrentEntryDeleted, Converter={StaticResource BoolToVisInv}}"
                                ToolTip="收藏"
                                Width="36" Height="36">
                            <Grid>
                                <!-- Outlined star (not favorite) -->
                                <h:AppIcon Icon="{x:Static h:Icon.Star}" Size="18"
                                           Foreground="{DynamicResource BrushFavorite}">
                                    <h:AppIcon.Style>
                                        <Style TargetType="h:AppIcon">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentEntry.IsFavorite}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </h:AppIcon.Style>
                                </h:AppIcon>
                                <!-- Filled star (favorite) -->
                                <h:AppIcon Icon="{x:Static h:Icon.Star}" Size="18"
                                           IsFilled="True"
                                           Foreground="{DynamicResource BrushFavorite}">
                                    <h:AppIcon.Style>
                                        <Style TargetType="h:AppIcon">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentEntry.IsFavorite}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </h:AppIcon.Style>
                                </h:AppIcon>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="{DynamicResource BrushBorder}" Margin="0,0,0,20" />

                    <!-- ===== Username field ===== -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="账号"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   VerticalAlignment="Center" />

                        <!-- Read mode -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentEntry.Username}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInv}}" />
                        <!-- Edit mode -->
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource FlatTextBox}"
                                 Text="{Binding EditUsername, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />

                        <Button Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                Command="{Binding CopyUsernameCommand}"
                                ToolTip="复制账号"
                                Margin="4,0,0,0">
                            <h:AppIcon Icon="{x:Static h:Icon.Copy}" Size="14" />
                        </Button>
                    </Grid>

                    <!-- ===== Password field ===== -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="密码"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   VerticalAlignment="Center" />

                        <!-- Password display -->
                        <controls:PasswordField Grid.Column="1"
                                                PasswordText="{Binding DecryptedPassword}"
                                                IsPasswordVisible="{Binding ShowPassword}"
                                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInv}}" />

                        <!-- Edit mode password -->
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource FlatTextBox}"
                                 Text="{Binding EditPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />

                        <!-- Eye toggle -->
                        <Button Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                Command="{Binding TogglePasswordVisibilityCommand}"
                                ToolTip="显示/隐藏密码"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInv}}"
                                Margin="4,0,0,0">
                            <Grid>
                                <h:AppIcon Icon="{x:Static h:Icon.Eye}" Size="14">
                                    <h:AppIcon.Style>
                                        <Style TargetType="h:AppIcon">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </h:AppIcon.Style>
                                </h:AppIcon>
                                <h:AppIcon Icon="{x:Static h:Icon.EyeOff}" Size="14">
                                    <h:AppIcon.Style>
                                        <Style TargetType="h:AppIcon">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </h:AppIcon.Style>
                                </h:AppIcon>
                            </Grid>
                        </Button>

                        <!-- Copy password -->
                        <Button Grid.Column="3"
                                Style="{StaticResource IconButton}"
                                Command="{Binding CopyPasswordCommand}"
                                ToolTip="复制密码"
                                Margin="4,0,0,0">
                            <h:AppIcon Icon="{x:Static h:Icon.Copy}" Size="14" />
                        </Button>
                    </Grid>

                    <!-- ===== URL field ===== -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="网址"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   VerticalAlignment="Center" />

                        <!-- Read mode: clickable link -->
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInv}}">
                            <Hyperlink Command="{Binding OpenUrlCommand}"
                                       Foreground="{DynamicResource BrushPrimary}">
                                <Run Text="{Binding CurrentEntry.Url, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>

                        <!-- Edit mode -->
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource FlatTextBox}"
                                 Text="{Binding EditUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />

                        <Button Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                Command="{Binding OpenUrlCommand}"
                                ToolTip="在浏览器中打开"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInv}}"
                                Margin="4,0,0,0">
                            <h:AppIcon Icon="{x:Static h:Icon.ExternalLink}" Size="14" />
                        </Button>

                        <Button Grid.Column="3"
                                Style="{StaticResource IconButton}"
                                Command="{Binding CopyUrlCommand}"
                                ToolTip="复制网址"
                                Margin="4,0,0,0">
                            <h:AppIcon Icon="{x:Static h:Icon.Copy}" Size="14" />
                        </Button>
                    </Grid>

                    <!-- ===== Notes field ===== -->
                    <Grid Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="备注"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   Margin="0,0,0,6" />

                        <!-- Read mode -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource BrushSurface}"
                                CornerRadius="6"
                                Padding="12,10"
                                MinHeight="60"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInv}}">
                            <TextBlock Text="{Binding CurrentEntry.Notes}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Edit mode -->
                        <TextBox Grid.Row="1"
                                 Style="{StaticResource FlatTextBox}"
                                 Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="80"
                                 VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <!-- ===== Custom Fields ===== -->
                    <Grid Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="自定义字段"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   Margin="0,0,0,6" />

                        <Grid Grid.Row="1">
                            <controls:CustomFieldsEditor ItemsSource="{Binding CurrentEntry.CustomFields}"
                                                         IsEditing="False"
                                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInv}}" />
                            <controls:CustomFieldsEditor ItemsSource="{Binding EditCustomFields}"
                                                         IsEditing="True"
                                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Grid>

                    <!-- ===== Tags ===== -->
                    <Grid Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="标签"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   Margin="0,0,0,6" />

                        <controls:TagEditor Grid.Row="1"
                                            Tags="{Binding Tags}"
                                            IsEditing="{Binding IsEditing}" />
                    </Grid>

                    <!-- ===== Metadata ===== -->
                    <Border Background="{DynamicResource BrushSurfaceHover}"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource BrushTextTertiary}"
                                       Margin="0,0,0,4">
                                <Run Text="创建时间: " />
                                <Run Text="{Binding CurrentEntry.CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}', Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource BrushTextTertiary}">
                                <Run Text="修改时间: " />
                                <Run Text="{Binding CurrentEntry.ModifiedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}', Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- History drawer overlays the detail content and is command-bound to this VM. -->
        <controls:EntryHistoryPanel HistoryEntries="{Binding HistoryEntries}"
                                    Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVis}}"
                                    Panel.ZIndex="10" />
    </Grid>
</UserControl>
