<UserControl x:Class="CipherVault.UI.Views.Controls.PasswordField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:CipherVault.UI.Converters"
             xmlns:h="clr-namespace:CipherVault.UI.Helper"
             mc:Ignorable="d"
             d:DesignWidth="300" d:DesignHeight="36"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInv" IsInverted="True" />
    </UserControl.Resources>

    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="6"
            MinHeight="34"
            Padding="12,0">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Masked password display (default) -->
            <TextBlock Grid.Column="0"
                       Text="&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;"
                       FontSize="{DynamicResource FontSizePassword}"
                       FontFamily="{StaticResource FontPrimary}"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsPasswordVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisInv}}" />

            <!-- Plaintext password (when visible) -->
            <TextBlock Grid.Column="0"
                       Text="{Binding PasswordText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="{DynamicResource FontSizePassword}"
                       FontFamily="{StaticResource FontMono}"
                       Foreground="{DynamicResource BrushTextPrimary}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding IsPasswordVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />

        </Grid>
    </Border>
</UserControl>

