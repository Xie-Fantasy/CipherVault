<UserControl x:Class="CipherVault.UI.Views.Controls.CustomFieldsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:CipherVault.UI.Converters"
             xmlns:h="clr-namespace:CipherVault.UI.Helper"
             mc:Ignorable="d"
             d:DesignWidth="500" d:DesignHeight="200"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel>
        <ItemsControl ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Key}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Grid.Column="0" Style="{StaticResource FlatTextBox}"
                                     Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32" Padding="8,5"
                                     FontSize="{DynamicResource FontSizeCaption}"
                                     Visibility="{Binding IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />

                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Value}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                                                        <Condition Binding="{Binding IsSensitive}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="••••••••"
                                           FontSize="{DynamicResource FontSizePassword}"
                                           Foreground="{DynamicResource BrushTextPrimary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                                                        <Condition Binding="{Binding IsSensitive}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Style="{StaticResource FlatTextBox}"
                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32" Padding="8,5"
                                         Visibility="{Binding IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <ToggleButton Grid.Column="3"
                                          Style="{StaticResource IconToggleButton}"
                                          IsChecked="{Binding IsSensitive}"
                                          ToolTip="敏感字段（默认隐藏）"
                                          Margin="4,0"
                                          Visibility="{Binding IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                <h:AppIcon Icon="{x:Static h:Icon.EyeOff}" Size="14" />
                            </ToggleButton>

                            <Button Grid.Column="3"
                                    Command="{Binding DataContext.CopyCustomFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="复制字段" Margin="4,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <h:AppIcon Icon="{x:Static h:Icon.Copy}" Size="14" />
                            </Button>

                            <Button Grid.Column="4" Style="{StaticResource IconButton}"
                                    Command="{Binding DataContext.RemoveCustomFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="删除字段"
                                    Foreground="{DynamicResource BrushDanger}"
                                    Visibility="{Binding IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                <h:AppIcon Icon="{x:Static h:Icon.Trash2}" Size="14" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Style="{StaticResource GhostButton}"
                Command="{Binding DataContext.AddCustomFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                HorizontalAlignment="Left"
                Padding="10,6"
                Visibility="{Binding IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <h:AppIcon Icon="{x:Static h:Icon.Plus}" Size="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="添加自定义字段" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
