<UserControl x:Class="CipherVault.UI.Views.Controls.EntryHistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:CipherVault.UI.Converters"
             xmlns:h="clr-namespace:CipherVault.UI.Helper"
             mc:Ignorable="d"
             d:DesignWidth="400" d:DesignHeight="400"
             Background="{DynamicResource BrushBackground}">

    <UserControl.Resources>
        <conv:DateTimeToRelativeConverter x:Key="RelativeTime" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ContentControl Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0">
                        <h:AppIcon Icon="{x:Static h:Icon.Clock}" Size="16" />
                    </ContentControl>
                    <TextBlock Text="修改历史"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        Command="{Binding DataContext.ViewHistoryCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        ToolTip="关闭">
                    <h:AppIcon Icon="{x:Static h:Icon.X}" Size="14" />
                </Button>
            </Grid>
        </Border>

        <!-- History list (timeline style) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <ItemsControl ItemsSource="{Binding HistoryEntries, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Timeline dot and line -->
                            <Grid Grid.Column="0" Width="20">
                                <!-- Vertical line -->
                                <Rectangle Width="2"
                                           Fill="{DynamicResource BrushBorder}"
                                           HorizontalAlignment="Center"
                                           Margin="0,20,0,0" />
                                <!-- Dot -->
                                <Ellipse Width="10" Height="10"
                                         Fill="{DynamicResource BrushPrimary}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Top"
                                         Margin="0,5,0,0" />
                            </Grid>

                            <!-- Content -->
                            <Border Grid.Column="2"
                                    Background="{DynamicResource BrushSurface}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Timestamp -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextSecondary}" />
                                        <TextBlock Text=" · "
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextTertiary}" />
                                        <TextBlock Text="{Binding Timestamp, Converter={StaticResource RelativeTime}}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource BrushTextTertiary}" />
                                    </StackPanel>

                                    <!-- Change description -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding ChangeDescription}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8" />

                                    <!-- Restore button -->
                                    <Button Grid.Row="2"
                                            Style="{StaticResource GhostButton}"
                                            Padding="8,4"
                                            Height="28"
                                            HorizontalAlignment="Left"
                                            Command="{Binding DataContext.RestoreFromHistoryCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0">
                                                <h:AppIcon Icon="{x:Static h:Icon.Undo2}" Size="12" />
                                            </ContentControl>
                                            <TextBlock Text="恢复此版本"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>

